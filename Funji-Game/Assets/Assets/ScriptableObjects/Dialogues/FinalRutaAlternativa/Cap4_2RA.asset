  dialogueTurnsList:
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Un segundo \xBFesa es mi casa?"
  - <Character>k__BackingField: {fileID: 11400000, guid: f3f22ed838eafc944aaec648dfb4a6e5, type: 2}
    dialogueLine: "Hehehe vas a disculparme por esto\u2026"
  - <Character>k__BackingField: {fileID: 11400000, guid: 20936df941b608542a0f733b95d912d5, type: 2}
    dialogueLine: "OH DIOS; HIJA \xBFESTAS BIEN?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 20936df941b608542a0f733b95d912d5, type: 2}
    dialogueLine: "Espera un segundo, as\xED que as\xED sucedi\xF3\u2026 "
  - <Character>k__BackingField: {fileID: 11400000, guid: 20936df941b608542a0f733b95d912d5, type: 2}
    dialogueLine: "\xBFPERO QU\xC9 DIABLOS? \xBFQUIEN HARIA ALGO AS\xCF?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 20936df941b608542a0f733b95d912d5, type: 2}
    dialogueLine: "Ella\u2026 solo estuvo en el lugar incorrecto y en el momento
      incorrecto."
