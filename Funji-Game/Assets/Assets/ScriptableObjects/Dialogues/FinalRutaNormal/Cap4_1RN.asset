  dialogueTurnsList:
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Esto no tiene sentido \xBFPorque habr\xEDa yo de ser alguien que
      tiene las habilidades que tiene?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Y porque me dijeron a mi que ten\xEDa que buscar la verdad \xBFEso
      no es algo que es medio sospechoso? Digo, qu\xE9 diablos es para mi tan importante
      encontrar adem\xE1s de que mi hija se muri\xF3 por mi culpa?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "\xBFPorque tuve que ser yo quien lo deb\xEDa descubrir? \xBFPor
      qu\xE9 no el l\xEDder si se supone que es muy poderoso?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Algo realmente me huele muy raro aqu\xED y no me gusta en lo absoluto."
