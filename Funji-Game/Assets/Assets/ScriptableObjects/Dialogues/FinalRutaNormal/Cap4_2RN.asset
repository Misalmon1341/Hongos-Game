%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90696683129a2db4b9da6af5e6b9fc33, type: 3}
  m_Name: Cap4_2RN
  m_EditorClassIdentifier: 
  dialogueTurnsList:
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "\xA1Ah\xED est\xE1! \xA1La cura!"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Vaya\u2026 me siento\u2026 igual."
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "\xBFQu\xE9? \xBFPor qu\xE9 no pas\xF3 nada? \xBFQu\xE9 fue lo
      que hice mal?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: No no no no.
  - <Character>k__BackingField: {fileID: 11400000, guid: 7a3f326f73c722646b509c0d976e477f, type: 2}
    dialogueLine: Zeta al fin has llegado y dejame decir que esperaba mas de ti.
  - <Character>k__BackingField: {fileID: 11400000, guid: 7a3f326f73c722646b509c0d976e477f, type: 2}
    dialogueLine: "Solo hiciste lo que te ped\xED pero jam\xE1s te detuviste a pensar
      \xBFpor qu\xE9 est\xE1s aqu\xED en primer lugar? \xBFDime Zeta acaso no lo
      comprendes?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "\xBFQu\xE9? \xBFQu\xE9 es lo que est\xE1 sucediendo?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 7a3f326f73c722646b509c0d976e477f, type: 2}
    dialogueLine: "Oh Zeta\u2026 Siempre fui yo, yo estuve ah\xED para guiarte a
      m\xED y volverme m\xE1s fuerte y trascender, por eso te necesitaba y por eso
      estuve ah\xED incluso con tu hija\u2026"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Un minuto\u2026 \xBFFUISTE TU? \xBFTU SIEMPRE ESTUVISTE AH\xCD
      PARA DESTRUIRME?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "\xBFC\xD3MO TE ATREVES? \xBFQU\xC9 CLASE DE MONSTRUO ERES?"
  - <Character>k__BackingField: {fileID: 11400000, guid: 2d41504b2679a5a438eb0bd71c80e345, type: 2}
    dialogueLine: "Soy tu salvaci\xF3n Zeta, Por lo que debes dejar de resistirte
      y dejar que todo esto pase."
  - <Character>k__BackingField: {fileID: 11400000, guid: 032a2346ef398534db35bc592cddec26, type: 2}
    dialogueLine: "Hola mami, se que lo intentase, pero a\xFAn hay muchas cosas por
      hacer."
  - <Character>k__BackingField: {fileID: 11400000, guid: 032a2346ef398534db35bc592cddec26, type: 2}
    dialogueLine: "Se que no puedes hablar conmigo, porque yo a\xFAn sigo aqu\xED
      para ayudarte, pero debes encontrar todo\u2026"
  - <Character>k__BackingField: {fileID: 11400000, guid: 032a2346ef398534db35bc592cddec26, type: 2}
    dialogueLine: "As\xED que debes regresar y ayudarnos a todos, debes encontrar
      la verdad mami\u2026"
  - <Character>k__BackingField: {fileID: 11400000, guid: 032a2346ef398534db35bc592cddec26, type: 2}
    dialogueLine: "Te voy a extra\xF1ar mucho pero te prometo que nos veremos pronto."
