MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90696683129a2db4b9da6af5e6b9fc33, type: 3}
  m_Name: Cap4_3RA
  m_EditorClassIdentifier: 
  dialogueTurnsList:
  - <Character>k__BackingField: {fileID: 11400000, guid: 5ed68f852975d7c4bb2a1584744e11bc, type: 2}
    dialogueLine: "(Al recoger este flashback Zeta empieza a recordar lo que pas\xF3
      aquel d\xEDa pero esta vez nota algo raro, nota que el misterioso extra\xF1o
      tiene algo familiar). "
  - <Character>k__BackingField: {fileID: 11400000, guid: 5ed68f852975d7c4bb2a1584744e11bc, type: 2}
    dialogueLine: "(Algo que durante todo este tiempo se neg\xF3 a evitar, una cara
      que durante todo este tiempo y que siempre crey\xF3 que era su amigo\u2026)."
  - <Character>k__BackingField: {fileID: 11400000, guid: 5ed68f852975d7c4bb2a1584744e11bc, type: 2}
    dialogueLine: "(Esa persona del hospital, la de su casa, ese misterioso l\xEDder,
      todo encajaba, su cara encajaba, sus acciones y su objetivo encajaban\u2026)."
  - <Character>k__BackingField: {fileID: 11400000, guid: a0d1771ac6801224392f8290f9cc0970, type: 2}
    dialogueLine: "Un segundo\u2026 \xBFQUE?."
  - <Character>k__BackingField: {fileID: 11400000, guid: a0d1771ac6801224392f8290f9cc0970, type: 2}
    dialogueLine: ESE MALDITO, FUE EL.
  - <Character>k__BackingField: {fileID: 11400000, guid: a0d1771ac6801224392f8290f9cc0970, type: 2}
    dialogueLine: "\xC9l ME LO ARREBAT\xD3 TODO."
  - <Character>k__BackingField: {fileID: 11400000, guid: a0d1771ac6801224392f8290f9cc0970, type: 2}
    dialogueLine: Y SOLO FUI SU MARIONETA.
  - <Character>k__BackingField: {fileID: 11400000, guid: a0d1771ac6801224392f8290f9cc0970, type: 2}
    dialogueLine: Juro que EL LO PAGARA.
