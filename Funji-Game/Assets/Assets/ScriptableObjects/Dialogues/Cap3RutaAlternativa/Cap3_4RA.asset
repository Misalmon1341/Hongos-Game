  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90696683129a2db4b9da6af5e6b9fc33, type: 3}
  m_Name: Cap3_4RA
  m_EditorClassIdentifier: 
  dialogueTurnsList:
  - <Character>k__BackingField: {fileID: 11400000, guid: 5ed68f852975d7c4bb2a1584744e11bc, type: 2}
    dialogueLine: "Despu\xE9s de avanzar en el di\xE1logo del cartel de g\xE9nesis
      se acuerda que aqu\xED fueron los experimentos que le cont\xF3 Sylbanox y al
      ver algunos cuerpos de fungfolk en el piso recuerda que realmente si es el
      lugar ya que se da cuenta que tienen algunas marcas y es definitivo que los
      usaron para experimentaci\xF3n de la especie.\r\n"
  - <Character>k__BackingField: {fileID: 11400000, guid: cfdd06ad5a9c7cf41a65644cf0ecae81, type: 2}
    dialogueLine: "Todo esto\u2026 verdaderamente son unos monstruos, la gente con
      la que seg\xFAn trabajaba, lo que les hicieron\u2026 ahora entiendo porque
      escaparon de este infierno."
  - <Character>k__BackingField: {fileID: 11400000, guid: cfdd06ad5a9c7cf41a65644cf0ecae81, type: 2}
    dialogueLine: "Debo continuar para por lo menos asegurar que ning\xFAn otro de
      ellos vuelva a sufrir de esta forma."
